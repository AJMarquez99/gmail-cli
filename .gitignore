node_modules/
# Never commit credentials. The App Password lives in ~/.config/gmail-cli/credentials.json;
# guard against any local copy. The other config/log files can hold recipient addresses,
# so keep them out of the repo too (they normally live under ~/.config/gmail-cli/).
credentials.json
config.json
allowlist.json
sent.jsonl
rules.json
rules-*.json
*.local
.DS_Store

# npm pack artifact
*.tgz

# Agent project directory (.ai/) — committed as public project intelligence,
# governed by .ai/.gitignore (the `_*` local-only rule). Two exceptions kept local:
#   - context/ contents are regenerable session state (ignored via .ai/context/.gitignore)
#   - plans/ hold implementation history with personal account details — keep local,
#     but track the folder + its README so the convention stays legible.
.ai/plans/*
!.ai/plans/README.md

# Local agent instructions (dot-ai convention block) — kept local, not committed.
/CLAUDE.md
