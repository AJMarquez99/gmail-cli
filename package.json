{
  "name": "@ajmarquez99/gmail-cli",
  "version": "0.7.1",
  "description": "Gmail CLI with a fail-closed recipient allowlist — send (markdown, attachments, dry-run, threading, send log) plus IMAP read, label, and mark.",
  "type": "module",
  "bin": {
    "gmail": "./bin/gmail.js",
    "gmail-mcp": "./bin/gmail-mcp.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Alejandro Marquez",
  "repository": {
    "type": "git",
    "url": "https://github.com/AJMarquez99/gmail-cli.git"
  },
  "homepage": "https://github.com/AJMarquez99/gmail-cli#readme",
  "bugs": {
    "url": "https://github.com/AJMarquez99/gmail-cli/issues"
  },
  "keywords": [
    "gmail",
    "email",
    "cli",
    "smtp",
    "nodemailer",
    "send",
    "allowlist",
    "agentic"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "imapflow": "^1.4.0",
    "mailparser": "^3.9.9",
    "marked": "^18.0.5",
    "nodemailer": "^8.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "vitest": "^4.1.8"
  }
}
